{
  "regions": [
    "dub1"
  ],
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=4096"
    }
  },
  "crons": [
    {
      "path": "/api/cron/cj-catalog-sync",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/cj-enrichment",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/cj-marketplace-maintenance",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/cj-stock-health",
      "schedule": "10 11 * * *"
    },
    {
      "path": "/api/cron/order-tracking-sync",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/digital-license-expiry",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/cj-supplier-health",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/cj-catalog-cleanup",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/reconcile-payments",
      "schedule": "15 12 * * *"
    },
    {
      "path": "/api/cron/ugc-release-payouts",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/ugc/views/sync",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/retry-failed-webhooks",
      "schedule": "23 14 * * *"
    },
    {
      "path": "/api/cron/community-stories-refresh",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/growth-engine",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/media-ingest",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/cj-strategy-import",
      "schedule": "0 11 * * *"
    }
  ]
}
