{
  "regions": ["fra1"],

  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=4096"
    }
  },

  "crons": [
    {
      "path": "/api/cron/shopify-sync",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/cj-catalog-sync",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/cj-enrichment",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/cj-intelligence-daily",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/cj-auto-publish",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/cj-auto-publish-worker",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/cj-marketplace-maintenance",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/cj-stock-health",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/cj-supplier-health",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/cj-catalog-cleanup",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/marketplace-intelligence-trending",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/marketplace-intelligence-daily",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/ugc/views/sync",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/retry-failed-webhooks",
      "schedule": "0 2 * * *"
    }
  ]
}
