NEXT_PUBLIC_SUPABASE_URL=
# New API keys (preferred)
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy server fallback (optional — used only if SUPABASE_SECRET_KEY is unset)
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (public site key only — secret stays in Supabase Dashboard)
# Required when Supabase Auth CAPTCHA is enabled
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Login Turnstile gate (default: on when site key is set). Temporary demo-only:
# AUTH_TURNSTILE_ENABLED=false hides the /login widget only; remove and redeploy to restore.
# AUTH_TURNSTILE_ENABLED=
# Optional dedicated secret for signing 2FA verified cookies (falls back to Supabase secret key)
# TWO_FA_COOKIE_SECRET=

# Production site URL (canonical, OG tags, sitemap, payment callbacks)
# Vercel production: MUST be https://www.jimvio.com — localhost in a prod build breaks SEO
# Local dev only: http://localhost:3000 in .env.local
NEXT_PUBLIC_APP_URL=https://www.jimvio.com

# Transactional email (Resend — https://resend.com)
# Add DNS records in Resend for jimvio.com, then use an address on that domain.
RESEND_API_KEY=
EMAIL_FROM=Jimvio <notifications@yourdomain.com>
# Set to false to disable outbound email while keeping in-app notifications
# EMAIL_NOTIFICATIONS_ENABLED=false
# Force the growth engine to stay paused. Remove the variable to let an admin resume it.
# GROWTH_ENGINE_KILL=1
# Search Console read-only queries. Both names are required. The credential is the service-account JSON
# (type, client_email, private_key) with scope https://www.googleapis.com/auth/webmasters.readonly.
# In Search Console, add that client_email as a user on the property. Site value is https://www.jimvio.com/ or sc-domain:jimvio.com.
# GOOGLE_SEARCH_CONSOLE_SITE_URL=
# GOOGLE_SEARCH_CONSOLE_CREDENTIALS=
# Ads connectivity reads do not spend. Google needs all three. Meta needs both.
# Create a Google Ads developer token and an OAuth access token with read access, then set the 10-digit customer id.
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_ACCESS_TOKEN=
# Meta: Graph API access token with ads_read. Account id may include the act_ prefix.
# META_ADS_ACCOUNT_ID=
# META_ADS_ACCESS_TOKEN=
# Spend stays unimplemented. A cap and this flag do not create a charge.
# GROWTH_ADS_SPEND_CAP_USD=
# GROWTH_ADS_SPEND_AUTHORIZED=
# Safe Resend connectivity send, only if you run it yourself, goes to delivered@resend.dev. Do not put a user address here.

# If you use .env.local, it overrides .env for the same variable names.

# PesaPal and PayPal are RETIRED — do not set PESAPAL_* or PAYPAL_* for new checkouts.
# Historical orders may still show those provider names in order history.

# Shopify (Partner/Dev Dashboard → your app → Settings → Credentials)
# Client ID — public app client id for OAuth
SHOPIFY_CLIENT_ID=
# Client secret (shpss_…) — OAuth token exchange + optional webhook HMAC fallback
SHOPIFY_CLIENT_SECRET=
# Webhook HMAC secret (often same as client secret). Used by:
#   /api/webhooks/shopify and /api/webhooks/dropshipping/shopify
SHOPIFY_WEBHOOK_SECRET=
# OAuth scopes override (comma-separated). Defaults are least-privilege product/order/inventory/fulfillment.
# SHOPIFY_OAUTH_SCOPES=read_products,write_products,read_orders,write_orders,read_inventory,write_inventory,read_locations,read_fulfillments,write_fulfillments,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders
# Production callback (must match Shopify app Allowed redirection URL(s) exactly):
# SHOPIFY_OAUTH_REDIRECT_URI=https://www.jimvio.com/api/dropshipping/shopify/oauth/callback
# Public app base URL for idempotent webhook registration after connect:
# SHOPIFY_APP_URL=https://www.jimvio.com
# AES key for merchant Shopify tokens at rest (64-char hex or any long string). Falls back to APP_ENCRYPTION_KEY.
# SHOPIFY_ENCRYPTION_KEY=
# APP_ENCRYPTION_KEY=
# Optional: platform catalog via Admin API without shopify_credentials — use with JIMVIO_PLATFORM_SHOPIFY_VENDOR_ID
# Store: Settings → Develop apps → Admin API access token (shpat_…)
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
# e.g. 2024-07 or 2026-01 (must match an API version Shopify still serves)
SHOPIFY_API_VERSION=
# Random long string; send as Authorization: Bearer <value> to protected /api/cron/* routes (not the Shopify secret)
CRON_SECRET=
# Fail-closed. CJ product intelligence jobs stay off unless this is exactly "true".
CJ_PRODUCT_INTELLIGENCE_ENABLED=false
# One vendors.id UUID for platform-operated Shopify (see database/migrations/023_platform_shopify_vendor.sql)
JIMVIO_PLATFORM_SHOPIFY_VENDOR_ID=
JIMVIO_PLATFORM_WALLET_USER_ID=
# Default Jimvio % on Shopify sales when connecting a store (overridable in shopify_credentials)
SHOPIFY_DEFAULT_PLATFORM_COMMISSION_RATE=8

# PawaPay / AfriPay — RETIRED. Do not set PAWAPAY_* or AFRIPAY_* for checkout.

# NowPayments (optional crypto checkout)
# API key must match NOWPAYMENTS_ENV: sandbox keys from dashboard (sandbox mode) for api-sandbox.nowpayments.io; production keys for api.nowpayments.io
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Jimvio AI runs on the server through OpenAI. Set the key in Vercel for Production and Preview.
# Never prefix it with NEXT_PUBLIC_, and do not commit a real key.
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional. When unset, Jimvio uses gpt-4o-mini. That model is cost-effective and accepted by the installed OpenAI SDK Responses API.
# OPENAI_MODEL=gpt-4o-mini
# Gemini is the outage fallback only. Active routes call OpenAI first.
# Leave this key in place. Jimvio uses it after an OpenAI timeout or service outage, not for ordinary requests.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional server-only Geoapify key. It estimates an address for a location the user
# chose to share, and places a checkout street on the admin user page. Leave unset to
# show stored coordinates without an address estimate. Never prefix this with
# NEXT_PUBLIC, and do not commit a real key.
# GEOAPIFY_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# Tenor GIF search for community chat (https://developers.google.com/tenor/guides/quickstart)
# Optional — GIF picker returns empty results gracefully when unset.
TENOR_API_KEY=

# sandbox | production (case-insensitive; unset = production API)
NOWPAYMENTS_ENV=sandbox
NEXT_PUBLIC_NOWPAYMENTS_PUBLIC_KEY=
RWF_TO_USD_RATE=0.0008
# Same numeric value as RWF_TO_USD_RATE so client components can show RWF-stored prices as USD (optional but recommended)
NEXT_PUBLIC_RWF_TO_USD_RATE=0.0008

# ── Step 6 — multi-gateway router (lib/payments/router.ts) + FX (lib/currency/rates.ts) ──
# NOWPAYMENTS_* are defined above; do not duplicate.
EXCHANGE_RATE_API_URL=
FX_CACHE_TTL_MINUTES=

# ── UGC & Clipping — Social API tokens for view sync cron ───────────────────
# TikTok Research API v2 (Business account required)
# developers.tiktok.com → Manage Apps → Research API → Access Token
TIKTOK_ACCESS_TOKEN=

# Instagram Graph API Business Discovery — Facebook Login user token with approved instagram_basic + pages_read_engagement access.
# Business Discovery can read eligible public Business/Creator profiles only. See developers.facebook.com → your app → User Token
INSTAGRAM_ACCESS_TOKEN=
# Instagram professional account ID for Meta Business Discovery (Facebook Login; approved instagram_basic/pages_read_engagement access).
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# YouTube Data API v3 — unrestricted API key from console.cloud.google.com
YOUTUBE_API_KEY=

# X (Twitter) Bearer Token — developer.twitter.com → Projects & Apps → Keys & Tokens
X_BEARER_TOKEN=

# LiveKit (Live Studio media transport / SFU — NOT for business logic)
# Cloud: https://cloud.livekit.io → Project Settings → Keys
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional alias (server-only); client uses NEXT_PUBLIC_LIVEKIT_URL
# LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit Egress storage (required for durable recording that survives browser close)
# Prefer S3-compatible bucket; webhook /api/live/egress/webhook marks replay ready
# For Backblaze B2, use a standard S3-compatible application key pair (not the master key).
# Set the bucket's actual region; existing Jimvio B2 recordings use us-east-005.
# LIVEKIT_EGRESS_S3_BUCKET=jimvio-live-recordings
# LIVEKIT_EGRESS_S3_ACCESS_KEY=<Backblaze application key ID>
# LIVEKIT_EGRESS_S3_SECRET=<matching Backblaze application key>
# LIVEKIT_EGRESS_S3_REGION=us-east-005
# LIVEKIT_EGRESS_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com

# Multistream destinations (server-only — never NEXT_PUBLIC_*)
# AES-256 key: 64-char hex OR any passphrase (hashed). Required to store OAuth/stream keys.
LIVE_DESTINATION_ENCRYPTION_KEY=

# YouTube Live Streaming API OAuth — SEPARATE from Supabase Google login
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Web client
# Redirect (exact): https://www.jimvio.com/api/integrations/youtube/callback
# Scope (code): https://www.googleapis.com/auth/youtube.force-ssl
# Consent screen must declare the same scope. Sensitive scope → Google verification
# required for External users beyond test users ("Google hasn't verified this app").
# Do NOT reuse the Supabase Google login client for YouTube Live.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Twitch Helix OAuth (dev.twitch.tv) — Confidential client
# Redirect (exact): https://www.jimvio.com/api/integrations/twitch/callback
# Scopes (code): channel:manage:broadcast channel:read:stream_key
#   - channel:manage:broadcast → PATCH /helix/channels (stream title)
#   - channel:read:stream_key → GET /helix/streams/key (RTMPS ingest for LiveKit egress)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional override (default rtmps://live.twitch.tv:443/app)
# TWITCH_INGEST_URL=rtmps://live.twitch.tv:443/app

# Meta / Facebook Page Live Video API
# Requires App Review for Live Video API. Set META_LIVE_VIDEO_ENABLED=true only after approval.
META_APP_ID=
META_APP_SECRET=
# META_LIVE_VIDEO_ENABLED=true
# INSTAGRAM_LIVE_ENABLED=true

# TikTok Login Kit (OAuth 2.0) — account connection only
# Redirect: https://www.jimvio.com/api/integrations/tiktok/callback
# Scope: user.info.basic
# Web OAuth only (no PKCE). NEXT_PUBLIC_APP_URL must be https://www.jimvio.com in production —
# localhost origins are treated as Desktop by TikTok and require code_challenge.
# Does NOT enable TikTok LIVE multistream by itself.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Official TikTok LIVE streaming API — leave unset until App Review grants Live product.
# TIKTOK_LIVE_ENABLED=true

# Cloudinary (Live Studio recording assets / replay delivery)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional client alias
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Optional: Unsplash Search API for community photo seeding (catalog works without it)
# UNSPLASH_ACCESS_KEY=

# Optional: override ops upload base for seed:community-content
# JIMVIO_OPS_BASE_URL=https://www.jimvio.com

# Fail Next.js boot when Live Studio infra is incomplete (recommended for Live Studio production deploys)
# LIVE_STUDIO_REQUIRE_INFRA=true

# QuantForg trading signals → Jimvio Community integration
# Server-to-server secret for POST /api/webhooks/quantforg (HMAC or Bearer)
QUANTFORG_WEBHOOK_SECRET=
# Optional destination overrides (defaults to production QuantForg Signals Space)
# QUANTFORG_COMMUNITY_ID=
# QUANTFORG_SPACE_ID=
# QUANTFORG_ROOM_ID=
# QUANTFORG_SENDER_USER_ID=

# Production error monitoring (optional — standby until configured)
# Install @sentry/nextjs when activating; instrumentation boots via lib/ops/monitoring.ts
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# JIMVIO_ERROR_MONITORING_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Didit identity verification (KYC) — server-only; never expose to the client
# Console: https://business.didit.me — API key + workflow ID + webhook destination secret
# Webhook URL: https://www.jimvio.com/api/webhooks/didit
# DIDIT_API_KEY=
# DIDIT_WORKFLOW_ID=
# DIDIT_WEBHOOK_SECRET=
# Optional KYB workflow for physical product selling (falls back to DIDIT_WORKFLOW_ID if unset)
# DIDIT_BUSINESS_WORKFLOW_ID=

# Live Studio Playwright E2E (RC6)
# LIVE_E2E_BASE_URL=http://localhost:3000
# LIVE_E2E_STORAGE_STATE=.auth/live-host.json
# LIVE_E2E_VIEWER_STORAGE_STATE=.auth/live-viewer.json

# Commerce OS E2E. Leave every flag unset until disposable fixtures exist.
# Do not point these at historical customers, stores, or orders. .auth/ is gitignored.
# Storage files must be exactly:
#   .auth/commerce-merchant.json
#   .auth/commerce-customer.json
# Other files, including .auth/demo-jimvio.json, are refused.
# 1. Create disposable Supabase Auth users and sign in manually if Turnstile is on.
# 2. Read-only signed-in run: set only COMMERCE_E2E_ALLOW=1.
#    Leave MUTATE, PAYMENT_SANDBOX, SANDBOX_CONFIRMED, PRODUCTION_TARGET, and
#    PROBE_PRODUCTION unset. BASE_URL defaults to http://localhost:3000.
#    Start the local app first. The merchant file is required. The customer file
#    and STORE_HANDLE are required only for the customer page checks.
#    STORE_ID, product IDs, PAGE_ID, and UNPAID_ORDER_ID are not used on this pass.
#    The supplier-inventory rejection check runs without MUTATE. The live inventory
#    POST stays behind COMMERCE_E2E_MUTATE=1.
#    If you set MERCHANT_STORAGE or CUSTOMER_STORAGE, the value must be the exact
#    filename above. Any other path is ignored.
# 3. A www.jimvio.com or *.jimvio.com base also requires COMMERCE_E2E_PRODUCTION_TARGET=1.
# 4. COMMERCE_E2E_MUTATE=1 is required before create, import, edit, publish, or shipping writes.
# 5. Payment tests also require COMMERCE_E2E_PAYMENT_SANDBOX=1 and COMMERCE_E2E_SANDBOX_CONFIRMED=1
#    after the owner has verified the target uses sandbox API hosts and sandbox keys.
# NOWPAYMENTS_ENV=sandbox is not sufficient. NowPayments also needs NOWPAYMENTS_API_KEY
# and NOWPAYMENTS_IPN_SECRET. Flutterwave webhooks need FLW_WEBHOOK_SECRET
# (or FLUTTERWAVE_WEBHOOK_HASH) plus FLW_SECRET_KEY for transaction re-checks.
# COMMERCE_E2E_PROBE_PRODUCTION=1 is the only switch for unauthenticated production route checks.
# COMMERCE_E2E_ALLOW=
# COMMERCE_E2E_MUTATE=
# COMMERCE_E2E_PAYMENT_SANDBOX=
# COMMERCE_E2E_SANDBOX_CONFIRMED=
# COMMERCE_E2E_PRODUCTION_TARGET=
# COMMERCE_E2E_PROBE_PRODUCTION=
# COMMERCE_E2E_BASE_URL=http://localhost:3000
# COMMERCE_E2E_MERCHANT_STORAGE=.auth/commerce-merchant.json
# COMMERCE_E2E_CUSTOMER_STORAGE=.auth/commerce-customer.json
# COMMERCE_E2E_STORE_ID=
# COMMERCE_E2E_STORE_HANDLE=
# COMMERCE_E2E_MARKETPLACE_PRODUCT_ID=
# COMMERCE_E2E_SUPPLIER_PRODUCT_ID=
# COMMERCE_E2E_PAGE_ID=
# COMMERCE_E2E_UNPAID_ORDER_ID=

# --- UGC authenticated E2E (Playwright e2e/ugc-acceptance.spec.ts) ---
# Do NOT put passwords here. Create disposable Supabase Auth users, sign in
# manually (Turnstile may apply), then save Playwright storage states:
#   .auth/ugc-user-a.json
#   .auth/ugc-user-b.json
#   .auth/ugc-admin.json
# Store those files only in GitHub Actions Secrets / a secure runner volume.
# Required CI secret names (examples): UGC_E2E_USER_A_STORAGE_JSON,
# UGC_E2E_USER_B_STORAGE_JSON, UGC_E2E_ADMIN_STORAGE_JSON — write them to the
# paths above at job start. Never commit the JSON files.
#
# Guest production probes:
# UGC_E2E_PROBE_PRODUCTION=1
#
# Isolation (read-only):
# UGC_E2E_ALLOW=1
# UGC_E2E_BASE_URL=http://localhost:3000
# UGC_E2E_USER_A_STORAGE=.auth/ugc-user-a.json
# UGC_E2E_USER_B_STORAGE=.auth/ugc-user-b.json
# UGC_E2E_PRODUCTION_TARGET=   # set to 1 only for intentional www.jimvio.com runs
#
# Admin Blue Verification:
# UGC_E2E_ADMIN=1
# UGC_E2E_ADMIN_STORAGE=.auth/ugc-admin.json
#
# Payment sandbox (never real charges):
# UGC_E2E_MUTATE=1
# UGC_E2E_PAYMENT_SANDBOX=1
# UGC_E2E_SANDBOX_CONFIRMED=1
# Plus sandbox FLW_* / wallet keys already documented above.
# UGC_E2E_ALLOW=
# UGC_E2E_MUTATE=
# UGC_E2E_PAYMENT_SANDBOX=
# UGC_E2E_SANDBOX_CONFIRMED=
# UGC_E2E_PRODUCTION_TARGET=
# UGC_E2E_PROBE_PRODUCTION=
# UGC_E2E_ADMIN=
# UGC_E2E_BASE_URL=http://localhost:3000

# Digital product malware scanning. Leave unset until a scanner is available.
# Unset or unconfigured never marks a file clean.
#
# cloudmersive — uploads private Cloudinary file bytes to
# POST https://api.cloudmersive.com/virus/scan/file/advanced
# Header name is Apikey. DIGITAL_PRODUCT_SCANNER_TOKEN holds that key.
# DIGITAL_PRODUCT_SCANNER_URL is ignored in this mode.
# Free tier (pricing-small-business): 600 calls/month, 1 call/second, 3.5 MB max.
# DIGITAL_PRODUCT_SCANNER_MAX_BYTES defaults to 3500000. Raising it does not
# upgrade the Cloudmersive account. Files above the provider limit stay blocked.
# DIGITAL_PRODUCT_MAX_BYTES is only Jimvio's upload cap. It is not a scan limit.
# A clean result requires Cloudmersive CleanResult=true and Hash_SHA1 of the
# uploaded bytes. Jimvio stores SHA-256 of those same bytes. No engine version
# is invented; the advanced-scan schema does not return one.
# DIGITAL_PRODUCT_SCANNER=cloudmersive
# DIGITAL_PRODUCT_SCANNER_TOKEN=
# DIGITAL_PRODUCT_SCANNER_MAX_BYTES=3500000
#
# http — optional metadata proxy. Jimvio does not inspect bytes in this mode.
# POST JSON { digest, fileName, mime, sizeBytes } to an https URL.
# Authorization: Bearer DIGITAL_PRODUCT_SCANNER_TOKEN when that proxy expects it.
# A pass still requires { verdict: "clean", digest, bytesInspected: true }.
# DIGITAL_PRODUCT_SCANNER=http
# DIGITAL_PRODUCT_SCANNER_URL=
# DIGITAL_PRODUCT_MAX_BYTES=52428800
