    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "dotted-map": "^3.1.0",
    "emoji-mart": "^5.6.0",
    "exceljs": "^4.4.0",
    "exifr": "7.1.3",
    "fflate": "0.8.3",
    "framer-motion": "^11.18.2",
    "http-message-signatures": "^1.1.1",
    "input-otp": "^1.5.0",
    "ipaddr.js": "2.5.0",
    "isomorphic-dompurify": "^3.13.0",
    "livekit-client": "^2.25.0",
    "livekit-server-sdk": "^2.20.1",
    "lucide-react": "^0.469.0",
    "maplibre-gl": "^6.19.0",
    "next": "^16.4.6",
    "next-cloudinary": "^6.17.5",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "openai": "^4.77.3",
    "otpauth": "^9.6.0",
    "pdfkit": "^0.21.0",
