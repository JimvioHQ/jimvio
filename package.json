    "react-markdown": "^10.1.0",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.1",
    "schema-dts": "^2.1.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "swiper": "^12.1.4",
    "swr": "^2.5.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "three": "^0.187.0",
    "tldts": "7.5.5",
    "uuid": "^14.0.3",
    "zod": "^3.24.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.19.15",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/qs": "^6.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.187.0",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "sharp": "^0.35.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  }
}
