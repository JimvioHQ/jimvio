{
  "name": "jimvio",
  "version": "1.0.0",
  "description": "JIMVIO - Global Creator-Commerce Ecosystem",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca next dev",
    "build": "cross-env NODE_OPTIONS=\"--use-system-ca --max-old-space-size=4096\" next build",
    "start": "cross-env NODE_OPTIONS=--use-system-ca next start",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:app": "eslint app components lib hooks services types proxy.ts instrumentation.ts --cache --cache-location .eslintcache",
    "type-check": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" tsc --noEmit",
    "type-check:build": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" tsc --noEmit -p tsconfig.build.json",
    "dev:check": "npm run type-check:build && npm run lint:app",
    "ci:prepush": "node scripts/pre-push-ci.mjs",
    "ci:verify": "node scripts/ci/verify-local.mjs",
    "ci:bootstrap": "bash scripts/ci/bootstrap.sh",
    "ci:deploy": "bash scripts/ci/deploy-runner.sh",
    "ci:readiness": "node scripts/ci/readiness-report.mjs",
    "ci:runner:setup": "bash scripts/ci/runner/setup.sh",
    "ci:runner:test": "node scripts/ci/runner/test-connectivity.mjs",
    "ci:runner:health": "bash scripts/ci/runner/health-check.sh",
    "ci:runner:recover": "bash scripts/ci/runner/recover.sh",
    "ci:secrets": "node scripts/ci/verify-secrets.mjs",
    "ci:secrets:guide": "node scripts/ci/secrets-guide.mjs",
    "ci:audit": "node scripts/ci/audit.mjs",
    "ci:status": "node scripts/ci/status.mjs",
    "test": "node scripts/run-verifies.mjs",
    "test:community": "cross-env VERIFY_FILTER=community node scripts/run-verifies.mjs",
    "test:live": "cross-env VERIFY_FILTER=live node scripts/run-verifies.mjs",
    "test:ugc": "cross-env VERIFY_FILTER=ugc node scripts/run-verifies.mjs",
    "test:auth": "cross-env VERIFY_FILTER=auth,recovery,privilege,phase6,phase8 node scripts/run-verifies.mjs",
    "smoke:critical": "node scripts/smoke/critical-flows.mjs",
    "release:verify-migrations": "node scripts/release/verify-migrations.mjs",
    "release:verify-env": "node scripts/release/verify-env.mjs",
    "release:health": "node scripts/release/post-deploy-health.mjs",
    "release:perf": "node scripts/release/performance-budget.mjs",
    "release:verify-workflows": "node scripts/release/verify-workflows.mjs",
    "pesapal:verify": "node scripts/pesapal-verify.mjs",
    "pawapay:generate-signing-key": "node scripts/generate-pawapay-signing-key.mjs",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
